# Configuration de la base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flashcard_share
DB_USER=postgres
DB_PASSWORD=your_password_here

# Configuration du serveur
PORT=3001
NODE_ENV=development

# CORS - Domaine autorisé (votre frontend)
ALLOWED_ORIGIN=http://localhost:3000

# Clé API Gemini pour les Magic Lessons (POST /api/magic/generate)
# Elle reste sur le serveur : elle n'est jamais envoyée au navigateur des utilisateurs
GEMINI_API_KEY=your_gemini_api_key_here
# Modèle Gemini (optionnel, défaut : gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash
